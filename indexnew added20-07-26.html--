  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: "#0f172a",
            secondary: "#1e293b",
            accent: "#3b82f6",
            soft: "#f8fafc"
          },
          fontFamily: {
            sans: ["Inter", "system-ui", "sans-serif"]
          },
          animation: {
            "fade-in": "fadeIn 0.6s ease-in-out",
            "slide-up": "slideUp 0.8s ease-out",
            float: "float 3s ease-in-out infinite"
          },
        },
      },
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --radius-md: 12px;
      --radius-lg: 16px;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }

    body {
      font-family: "Inter", sans-serif;
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }

    .hero-gradient {
      background: linear-gradient(135deg, #1e293b 0%, #1e40af 50%, #334155 100%);
      position: relative;
      overflow: hidden;
    }

    .hero-gradient::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.05)"/><circle cx="50" cy="10" r="0.5" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
      opacity: 0.3;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
      animation: float 3s ease-in-out infinite;
    }

    .product-card {
      background: rgba(255, 255, 255, 0.78);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 24px;
      overflow: hidden;
      transition: all 0.45s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }

    .product-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow:
        0 25px 60px rgba(59, 130, 246, 0.18),
        0 10px 25px rgba(0, 0, 0, 0.12);
    }

    .product-image-container {
      position: relative;
      width: 100%;
      height: 250px;
      overflow: hidden;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      transition: transform 0.7s ease;
      background: white;
      padding: 20px;
    }

    .product-card:hover .product-image {
      transform: scale(1.05);
    }

    .product-image-fallback {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
      color: #9ca3af;
      font-size: 14px;
      text-align: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .contact-icon {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .contact-icon:hover {
      transform: scale(1.15) rotate(5deg);
    }

    .floating-element {
      animation: float 3s ease-in-out infinite;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    .gradient-text {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .section-divider {
      background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
      height: 1px;
      margin: 2rem 0;
    }

    #scrollToTop {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
    }

    #scrollToTop:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 35px rgba(59, 130, 246, 0.4);
    }

    .nav-blur {
      backdrop-filter: blur(20px);
      background: rgba(255, 255, 255, 0.95);
    }

    .pulse-ring {
      animation: pulse-ring 2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.8);
        opacity: 1;
      }

      80%,
      100% {
        transform: scale(1.2);
        opacity: 0;
      }
    }

    .product-card {
      animation: subtle-blink 3s ease-in-out infinite;
    }

    @keyframes subtle-blink {

      0%,
      100% {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      }

      50% {
        box-shadow: 0 12px 40px rgba(59, 130, 246, 0.2);
      }
    }

    .feature-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(248, 250, 252, 0.9));
      border: 1px solid rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(10px);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .feature-card:hover {
      animation: float 3s ease-in-out infinite;
    }

    .btn-primary {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #1d4ed8, #1e40af);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
    }

    .btn-secondary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      transition: all 0.3s ease;
    }

    .btn-secondary:hover {
      background: linear-gradient(135deg, #d97706, #b45309);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(245, 158, 11, 0.3);
    }

    body.dark {
      background: linear-gradient(135deg, #0f172a 0%, #020617 100%);
      color: #e2e8f0;
    }

    .dark .glass-card {
      background: rgba(30, 41, 59, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .dark .product-card {
      background: rgba(30, 41, 59, 0.9);
    }

    .dark .feature-card {
      background: rgba(30, 41, 59, 0.8);
    }

    .dark .text-gray-800 {
      color: #e2e8f0;
    }

    .dark .text-gray-700,
    .dark .text-gray-600 {
      color: #cbd5f5;
    }

    .dark .nav-blur {
      background: rgba(15, 23, 42, 0.9);
    }

    .qty-btn {
      border: 2px solid #cbd5e1;
      border-radius: 9999px;
      padding: 4px 14px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      background: transparent;
      color: #475569;
      user-select: none;
    }

    .qty-btn:hover {
      border-color: #3b82f6;
      color: #3b82f6;
    }

    .qty-btn.active {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);
    }

    .add-to-cart-btn {
      width: 100%;
      margin-top: 10px;
      padding: 9px 14px;
      border-radius: 0.75rem;
      border: none;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.25s ease;
    }

    .add-to-cart-btn:hover {
      background: linear-gradient(135deg, #d97706, #b45309);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
    }

    .add-to-cart-btn.added {
      background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .enquiry-trigger-btn {
      background: linear-gradient(135deg, #f97316, #ea580c);
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .enquiry-trigger-btn:hover {
      background: linear-gradient(135deg, #ea580c, #c2410c);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(249, 115, 22, 0.4);
    }

    .cart-icon-btn {
      position: relative;
      top: auto;
      bottom: auto;
      right: auto;
      z-index: 60;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
      transition: all 0.3s ease;
    }

    .cart-icon-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(245, 158, 11, 0.5);
    }

    .cart-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      background: #ef4444;
      color: white;
      font-size: 11px;
      font-weight: 700;
      min-width: 20px;
      height: 20px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cart-panel {
      position: fixed;
      top: 80px;
      bottom: auto;
      right: 1rem;
      z-index: 70;
      width: 320px;
      max-height: 75vh;
      background: white;
      border-radius: 1.25rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: bottom right;
    }

    .cart-panel.hidden {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.85);
    }

    .dark .cart-panel {
      background: #1e293b;
    }

    .cart-panel-header {
      padding: 16px 20px;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(135deg, #1e293b, #1e40af);
      color: white;
    }

    .cart-items-list {
      overflow-y: auto;
      flex: 1;
      padding: 12px 16px;
      max-height: 320px;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 13px;
    }

    .dark .cart-item-row {
      border-color: #334155;
    }

    .cart-item-qty-ctrl {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
    }

    .cart-qty-btn {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 1.5px solid #cbd5e1;
      background: transparent;
      cursor: pointer;
      font-weight: 700;
    }

    .cart-qty-btn:hover {
      border-color: #3b82f6;
      color: #3b82f6;
    }

    .cart-panel-footer {
      padding: 14px 20px;
      border-top: 1px solid #e2e8f0;
      background: #f8fafc;
    }

    .dark .cart-panel-footer {
      background: #0f172a;
      border-color: #334155;
    }

    .cart-empty-msg {
      text-align: center;
      padding: 32px 16px;
      color: #94a3b8;
      font-size: 14px;
    }

    .gpay-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 12px;
      border-radius: 0.875rem;
      font-weight: 700;
      background: linear-gradient(135deg, #34a853, #1a8a3c);
      color: #fff;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .gpay-btn:hover {
      background: linear-gradient(135deg, #2d9142, #0f6e2d);
      transform: translateY(-1px);
    }

    #enquiryModal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(6px);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    #enquiryModal.show {
      display: flex !important;
    }

    .enquiry-modal-box {
      background: #fff;
      border-radius: 22px;
      width: 100%;
      max-width: 500px;
      max-height: 92vh;
      overflow-y: auto;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
      animation: enquiryModalIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes enquiryModalIn {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .enquiry-modal-header {
      background: linear-gradient(135deg, #1e293b 0%, #1e40af 60%, #334155 100%);
      border-radius: 22px 22px 0 0;
      padding: 22px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
    }

    .enquiry-close-btn {
      background: rgba(255, 255, 255, 0.15);
      border: none;
      color: #fff;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
    }

    .enquiry-close-btn:hover {
      background: rgba(255, 255, 255, 0.28);
      transform: scale(1.08);
    }

    .enquiry-body {
      padding: 24px;
    }

    .enquiry-product-preview {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #f0f9ff;
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 22px;
      border: 1px solid #bae6fd;
    }

    .enquiry-product-preview img {
      width: 72px;
      height: 72px;
      object-fit: contain;
      background: #fff;
      border-radius: 12px;
    }

    .enquiry-qty-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .enquiry-qty-btn {
      padding: 8px 18px;
      border: 2px solid #cbd5e1;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      background: transparent;
      cursor: pointer;
      transition: 0.2s;
    }

    .enquiry-qty-btn.active {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      border-color: transparent;
      color: #fff;
    }

    .enquiry-textarea,
    .enquiry-input {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid #e2e8f0;
      border-radius: 13px;
      font-size: 0.9rem;
      background: #f8fafc;
      transition: 0.2s;
    }

    .enquiry-input:focus,
    .enquiry-textarea:focus {
      border-color: #3b82f6;
      outline: none;
      background: #fff;
    }

    .enquiry-submit-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 15px;
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #fff;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 8px;
    }

    .fly-item {
      position: fixed;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 36px;
      z-index: 9999;
      pointer-events: none;
      transition: none;
    }

    @media (max-width: 480px) {
      .cart-panel {
        top: 70px;
        right: 0.5rem;
        width: calc(100vw - 1rem);
      }
    }

    /* ===== 2026 professional polish additions below (nothing above was removed) ===== */

    ::selection {
      background: #3b82f6;
      color: #fff;
    }

    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #3b82f6, #1d4ed8);
      border-radius: 999px;
    }

    .dark ::-webkit-scrollbar-track {
      background: #0f172a;
    }

    .skip-link {
      position: absolute;
      left: 1rem;
      top: -60px;
      z-index: 100;
      background: #1d4ed8;
      color: #fff;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      transition: top 0.2s ease;
    }

    .skip-link:focus {
      top: 1rem;
    }

    .theme-toggle-btn {
      position: relative;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1e293b, #334155);
      color: #fbbf24;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.25);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .theme-toggle-btn:hover {
      transform: translateY(-2px) rotate(15deg);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.35);
    }

    .dark .theme-toggle-btn {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #1e293b;
    }

    .trust-strip {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(8px);
      border-top: 1px solid rgba(255, 255, 255, 0.4);
      border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    }

    .dark .trust-strip {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(255, 255, 255, 0.05);
    }

    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid rgba(59, 130, 246, 0.15);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
      font-weight: 600;
      font-size: 0.85rem;
      color: #1e293b;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      white-space: nowrap;
    }

    .trust-badge:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(59, 130, 246, 0.18);
    }

    .dark .trust-badge {
      background: rgba(30, 41, 59, 0.85);
      color: #e2e8f0;
      border-color: rgba(255, 255, 255, 0.08);
    }

    .whatsapp-float-btn {
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      z-index: 50;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #25d366, #128c7e);
      color: #fff;
      font-size: 26px;
      box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
    }

    .whatsapp-float-btn:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 12px 32px rgba(37, 211, 102, 0.5);
    }

    .img-shimmer {
      position: relative;
      overflow: hidden;
      background: #e2e8f0;
    }

    .img-shimmer::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
      transform: translateX(-100%);
      animation: shimmerSweep 1.4s ease-in-out infinite;
    }

    @keyframes shimmerSweep {
      100% {
        transform: translateX(100%);
      }
    }

    @media print {

      header,
      #scrollToTop,
      .whatsapp-float-btn,
      .theme-toggle-btn,
      .cart-icon-btn,
      .cart-panel,
      #enquiryModal {
        display: none !important;
      }
    }
  </style>
</head>

