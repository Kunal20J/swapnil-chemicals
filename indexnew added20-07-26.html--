        description: "Ultra soft Micro Towel"
      },
      {
        id: 8,
        name: "Micro Towel",
        image: "Micro Towel 2.jpg",
        price: 110,
        unit: "per piece",
        hasLtOptions: true,
        qtyOptions: [5, 10, 20],
