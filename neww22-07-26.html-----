<!doctype html>
<!-- Automobile 19-05-26 — redesigned 2026-07-22 for a cleaner, more restrained corporate look -->
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Swapnil Chemicals</title>
  <link rel="icon" type="image/jpeg" href="SC Logo.jpg" />
  <link rel="apple-touch-icon" href="SC Logo.jpg" />
  <meta name="description" content="Swapnil Chemicals - Leading manufacturers of automobile cleaning products in Jaipur. Bulk & retail. Dashboard polish, tyre polish, car wash & more." />
  <meta name="keywords" content="automobile cleaning, car cleaning, dashboard polish, tyre polish, car wash, glass cleaner, Jaipur manufacturer" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: "#0f172a",
            secondary: "#1e293b",
            accent: "#2563eb",
            soft: "#f8fafc"
          },
          fontFamily: {
            sans: ["Inter", "system-ui", "sans-serif"]
          },
          animation: {
            "fade-in": "fadeIn 0.6s ease-out",
            "slide-up": "slideUp 0.7s ease-out"
          },
        },
      },
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --ink: #0f172a;
      --ink-soft: #1e293b;
      --accent: #2563eb;
      --accent-dark: #1d4ed8;
      --amber: #d97706;
      --amber-dark: #b45309;
      --border-subtle: rgba(15, 23, 42, 0.08);
      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06), 0 1px 1px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 10px 28px -10px rgba(15, 23, 42, 0.16);
      --shadow-lg: 0 24px 48px -16px rgba(15, 23, 42, 0.22);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }

    body {
      font-family: "Inter", sans-serif;
      background: #f8fafc;
      -webkit-font-smoothing: antialiased;
    }

    /* ---------- Hero ---------- */
    .hero-gradient {
      background:
        radial-gradient(60% 80% at 15% 10%, rgba(37, 99, 235, 0.35), transparent 60%),
        radial-gradient(50% 70% at 90% 90%, rgba(59, 130, 246, 0.18), transparent 60%),
        linear-gradient(160deg, var(--ink) 0%, var(--ink-soft) 55%, #111827 100%);
      position: relative;
      overflow: hidden;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.08);
      color: var(--accent-dark);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .eyebrow-light {
      background: rgba(255, 255, 255, 0.1);
      color: #bfdbfe;
    }

    .section-heading {
      color: var(--ink);
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    /* ---------- Cards ---------- */
    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-sm);
      border-radius: var(--radius-lg);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }

    .feature-card {
      background: #fff;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }

    .icon-tile {
      background: linear-gradient(135deg, var(--ink) 0%, var(--accent) 100%);
      box-shadow: 0 8px 18px -6px rgba(37, 99, 235, 0.35);
    }

    .product-card {
      background: #fff;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: var(--shadow-sm);
    }

    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
    }

    .product-image-container {
      position: relative;
      width: 100%;
      height: 240px;
      overflow: hidden;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--border-subtle);
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      transition: transform 0.5s ease;
      background: #f8fafc;
      padding: 20px;
    }

    .product-card:hover .product-image {
      transform: scale(1.04);
    }

    .product-image-fallback {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #f1f5f9;
      color: #94a3b8;
      font-size: 13px;
      text-align: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .contact-icon {
      transition: transform 0.25s ease;
    }

    .contact-icon:hover {
      transform: translateY(-3px);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .section-divider {
      background: linear-gradient(90deg, transparent, var(--border-subtle), transparent);
      height: 1px;
      margin: 2rem 0;
    }

    #scrollToTop {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--ink);
      box-shadow: var(--shadow-md);
    }

    #scrollToTop:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lg);
    }

    .nav-blur {
      backdrop-filter: blur(16px);
      background: rgba(255, 255, 255, 0.92);
    }

    .pulse-ring {
      animation: pulse-ring 2.2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.8);
        opacity: 1;
      }

      80%,
      100% {
        transform: scale(1.3);
        opacity: 0;
      }
    }

    .btn-primary {
      background: var(--accent);
      transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
      box-shadow: var(--shadow-md);
    }

    .btn-primary:hover {
      background: var(--accent-dark);
      transform: translateY(-2px);
      box-shadow: 0 16px 32px -12px rgba(37, 99, 235, 0.45);
    }

    .btn-secondary {
      background: transparent;
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      transition: all 0.25s ease;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.5);
      transform: translateY(-2px);
    }

    body.dark {
      background: #0b1120;
      color: #e2e8f0;
    }

    .dark .glass-card,
    .dark .feature-card,
    .dark .product-card {
      background: #111a2e;
      border-color: rgba(255, 255, 255, 0.06);
    }

    .dark .text-gray-800 {
      color: #e2e8f0;
    }

    .dark .text-gray-700,
    .dark .text-gray-600 {
      color: #94a3b8;
    }

    .dark .nav-blur {
      background: rgba(11, 17, 32, 0.92);
    }

    .qty-btn {
      border: 1.5px solid #cbd5e1;
      border-radius: 999px;
      padding: 5px 14px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      background: transparent;
      color: #475569;
      user-select: none;
    }

    .qty-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .qty-btn.active {
      background: var(--accent);
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .add-to-cart-btn {
      width: 100%;
      margin-top: 10px;
      padding: 10px 14px;
      border-radius: 0.75rem;
      border: none;
      background: var(--amber);
      color: white;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.25s ease;
    }

    .add-to-cart-btn:hover {
      background: var(--amber-dark);
      transform: translateY(-1px);
      box-shadow: 0 8px 18px -6px rgba(217, 119, 6, 0.4);
    }

    .add-to-cart-btn.added {
      background: #16a34a;
    }

    .enquiry-trigger-btn {
      background: var(--ink-soft);
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .enquiry-trigger-btn:hover {
      background: var(--ink);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .cart-icon-btn {
      position: relative;
      z-index: 60;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--amber);
      color: white;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 22px -8px rgba(217, 119, 6, 0.45);
      transition: all 0.25s ease;
    }

    .cart-icon-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -8px rgba(217, 119, 6, 0.5);
    }

    .cart-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      background: #ef4444;
      color: white;
      font-size: 11px;
      font-weight: 700;
      min-width: 20px;
      height: 20px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cart-panel {
      position: fixed;
      top: 80px;
      right: 1rem;
      z-index: 70;
      width: 320px;
      max-height: 75vh;
      background: white;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: top right;
      border: 1px solid var(--border-subtle);
    }

    .cart-panel.hidden {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.92) translateY(-6px);
    }

    .dark .cart-panel {
      background: #111a2e;
    }

    .cart-panel-header {
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--ink);
      color: white;
    }

    .cart-items-list {
      overflow-y: auto;
      flex: 1;
      padding: 12px 16px;
      max-height: 320px;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 13px;
    }

    .dark .cart-item-row {
      border-color: #1e2a42;
    }

    .cart-item-qty-ctrl {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
    }

    .cart-qty-btn {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 1.5px solid #cbd5e1;
      background: transparent;
      cursor: pointer;
      font-weight: 700;
    }

    .cart-qty-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .cart-panel-footer {
      padding: 14px 20px;
      border-top: 1px solid var(--border-subtle);
      background: #f8fafc;
    }

    .dark .cart-panel-footer {
      background: #0b1120;
      border-color: #1e2a42;
    }

    .cart-empty-msg {
      text-align: center;
      padding: 32px 16px;
      color: #94a3b8;
      font-size: 14px;
    }

    .gpay-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 12px;
      border-radius: 0.875rem;
      font-weight: 700;
      background: #1a8a3c;
      color: #fff;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .gpay-btn:hover {
      background: #0f6e2d;
      transform: translateY(-1px);
    }

    #enquiryModal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(6px);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    #enquiryModal.show {
      display: flex !important;
    }

    .enquiry-modal-box {
      background: #fff;
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 500px;
      max-height: 92vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      animation: slideUp 0.3s ease-out;
    }

    .enquiry-modal-header {
      background: var(--ink);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding: 22px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
    }

    .enquiry-close-btn {
      background: rgba(255, 255, 255, 0.12);
      border: none;
      color: #fff;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
    }

    .enquiry-close-btn:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    .enquiry-body {
      padding: 24px;
    }

    .enquiry-product-preview {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #f8fafc;
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 22px;
      border: 1px solid var(--border-subtle);
    }

    .enquiry-product-preview img {
      width: 68px;
      height: 68px;
      object-fit: contain;
      background: #fff;
      border-radius: 12px;
    }

    .enquiry-qty-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .enquiry-qty-btn {
      padding: 8px 18px;
      border: 1.5px solid #cbd5e1;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      background: transparent;
      cursor: pointer;
      transition: 0.2s;
    }

    .enquiry-qty-btn.active {
      background: var(--accent);
      border-color: transparent;
      color: #fff;
    }

    .enquiry-textarea,
    .enquiry-input {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid #e2e8f0;
      border-radius: 13px;
      font-size: 0.9rem;
      background: #f8fafc;
      transition: 0.2s;
    }

    .enquiry-input:focus,
    .enquiry-textarea:focus {
      border-color: var(--accent);
      outline: none;
      background: #fff;
    }

    .enquiry-submit-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 15px;
      background: #128c7e;
      color: #fff;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 8px;
      transition: background 0.25s ease;
    }

    .enquiry-submit-btn:hover {
      background: #0e6b60;
    }

    .fly-item {
      position: fixed;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--amber);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 22px;
      z-index: 9999;
      pointer-events: none;
      transition: none;
    }

    @media (max-width: 480px) {
      .cart-panel {
        top: 70px;
        right: 0.5rem;
        width: calc(100vw - 1rem);
      }
    }
  </style>
</head>

<body class="min-h-screen text-gray-800">

  <header class="sticky top-0 z-50 nav-blur border-b border-slate-200/70">
    <div class="container mx-auto px-4 py-3.5">
      <div class="flex flex-col md:flex-row justify-between items-center gap-3">
        <div class="flex items-center space-x-4">
          <div class="relative">
            <div class="w-12 h-12 rounded-full flex items-center justify-center overflow-hidden ring-1 ring-slate-200"><img src="SC Logo.jpg" alt="Swapnil Chemicals logo" class="w-full h-full object-cover" decoding="async" /></div>
            <div class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-green-500 rounded-full ring-2 ring-white pulse-ring"></div>
          </div>
          <div>
            <h1 class="text-xl font-extrabold tracking-tight text-slate-900">Swapnil Chemicals</h1>
            <p class="text-xs text-gray-500">Manufacturers & marketers of automobile cleaning products</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-full border border-slate-200 bg-white text-sm text-gray-600 font-medium">
            <i class="fas fa-map-marker-alt text-blue-600"></i>Jaipur • Bulk & Retail
          </div>
          <button class="cart-icon-btn" onclick="toggleCart()" aria-label="Open cart">
            <i class="fas fa-shopping-cart text-base"></i>
            <span class="cart-badge" id="cartBadge" style="display:none" aria-live="polite">0</span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <section class="hero-gradient text-white min-h-[80vh] flex items-center relative">
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center animate-slide-up">
        <span class="eyebrow eyebrow-light"><i class="fas fa-industry"></i>Manufacturing excellence since 2020</span>
        <h2 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight tracking-tight">Premium Automobile <br><span class="text-blue-400">Cleaning Solutions</span></h2>
        <p class="text-lg md:text-xl mb-10 text-slate-300 max-w-2xl mx-auto leading-relaxed">Trusted bulk & retail manufacturing of dashboard polish, tyre polish, car wash and more — built for professional results.</p>
        <div class="flex flex-wrap justify-center gap-4"><a href="#products" class="btn-primary text-white px-8 py-3.5 rounded-xl font-semibold"><i class="fas fa-boxes mr-2"></i>View Products</a><a href="#contact" class="btn-secondary text-white px-8 py-3.5 rounded-xl font-semibold"><i class="fas fa-phone mr-2"></i>Contact Now</a></div>
      </div>
    </div>
    <div class="absolute top-20 left-10 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl"></div>
    <div class="absolute bottom-20 right-10 w-36 h-36 bg-blue-400/10 rounded-full blur-2xl"></div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="eyebrow">Company Details</span>
        <h2 class="text-3xl md:text-4xl section-heading mb-3">Business Details</h2>
        <div class="section-divider max-w-xs mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="feature-card p-7">
          <div class="flex items-center mb-1">
            <div class="w-14 h-14 icon-tile rounded-2xl flex items-center justify-center mr-5"><i class="fas fa-user-tie text-white text-xl"></i></div>
            <div>
              <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact Person</h3>
              <p class="text-xl font-bold text-gray-800">Gajendra Jain</p>
            </div>
          </div>
        </div>
        <div class="feature-card p-7">
          <div class="flex items-center mb-1">
            <div class="w-14 h-14 icon-tile rounded-2xl flex items-center justify-center mr-5"><i class="fas fa-phone text-white text-xl"></i></div>
            <div>
              <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</h3>
