  <div id="enquiryModal">
    <div class="enquiry-modal-box" role="dialog" aria-modal="true" aria-label="Enquiry form">
      <div class="enquiry-modal-header">
        <div>
          <h2 style="color:#fff; font-size:1.15rem; font-weight:700;">Enquiry Form</h2>
          <p style="color:rgba(255,255,255,0.65); font-size:0.75rem;">Tell us about your requirements</p>
        </div><button class="enquiry-close-btn" onclick="closeEnquiryModal()" aria-label="Close enquiry form">✕</button>
      </div>
      <div class="enquiry-body">
        <div class="enquiry-product-preview"><img id="enquiry-product-img" src="" alt="Selected Product" loading="lazy" decoding="async">
          <div>
            <p class="text-xs font-bold text-sky-700">Selected Product</p>
            <p id="enquiry-product-name" class="font-bold text-gray-800"></p>
            <p id="enquiry-product-rate" class="text-sm font-semibold text-blue-600 mt-1"></p>
          </div>
        </div>
        <div class="enquiry-field-wrap"><label class="text-xs font-bold text-gray-600 uppercase">Quantity <i class="fas fa-layer-group"></i></label>
          <div id="enquiry-qty-buttons" class="enquiry-qty-buttons"></div><input type="hidden" id="enquiry-qty-value">
        </div>
        <div class="enquiry-field-wrap"><label class="text-xs font-bold text-gray-600 uppercase">Workshop / Address</label><textarea id="enquiry-details" class="enquiry-textarea" rows="2" placeholder="Your workshop name, city, special requests..."></textarea></div>
        <div class="enquiry-field-wrap"><label class="text-xs font-bold text-gray-600 uppercase">Your Phone Number *</label><input type="tel" id="enquiry-phone" class="enquiry-input" maxlength="10" placeholder="9876543210">
          <p id="phone-error" class="text-red-500 text-xs hidden mt-1">Enter valid 10-digit number</p>
        </div><button class="enquiry-submit-btn" onclick="submitEnquiry()"><i class="fab fa-whatsapp"></i> Send Enquiry via WhatsApp</button>
        <p class="text-center text-xs text-gray-400 mt-3">Directly sent to Swapnil Chemicals</p>
      </div>
    </div>
  </div>

  <script>
    "use strict";

    const APP = Object.freeze({
      WA_NUMBER: "919352470085",
      CART_STORAGE_KEY: "sc_cart_auto",
      CURRENCY: "INR",
      COUNTRY_CODE: "+91",
      CART_ANIMATION_MS: 2200
    });

    function isValidIndianMobile(value) {
      return /^[6-9]\d{9}$/.test(String(value || "").trim());
    }

    function safeParseJSON(raw, fallback) {
      try {
        const parsed = JSON.parse(raw);
        return parsed ?? fallback;
      } catch {
        return fallback;
      }
    }

    function safeOpenNewTab(url) {
      window.open(url, "_blank", "noopener,noreferrer");
    }

    const products = [{
        id: 1,
        name: "Dashboard Polish",
        image: "Dashboard Polish.jpeg",
        price: 200,
        unit: "Lt",
        hasLtOptions: true,
        description: "Premium dashboard polish for long-lasting shine"
      },
      {
        id: 2,
        name: "Tyre Polish",
        image: "Tyre Polish.jpeg",
        price: 150,
        unit: "Lt",
        hasLtOptions: true,
        description: "High-gloss tyre polish for enhanced appearance"
      },
      {
        id: 3,
        name: "Car Foaming Wash",
        image: "Car Foaming Wash.jpeg",
        price: 70,
        unit: "Lt",
        hasLtOptions: true,
        description: "Advanced foaming wash for thorough cleaning"
      },
      {
        id: 4,
        name: "Glass Cleaner",
        image: "Glass Cleaner.jpeg",
        price: 70,
        unit: "Lt",
        hasLtOptions: true,
        description: "Streak-free glass cleaner for crystal clear visibility"
      },
      {
        id: 5,
        name: "Interior Cleaner",
        image: "Interior Cleaner.png",
        price: 130,
        unit: "Lt",
        hasLtOptions: true,
        description: "Effective interior cleaner for all surfaces"
      },
      {
        id: 6,
        name: "Foaming Gun",
        image: "Foaming Gun.jpeg",
        price: 2000,
        unit: "per piece",
        hasLtOptions: false,
        description: "Professional foaming gun for car wash"
      },
      {
        id: 7,
        name: "Micro Towel",
        image: "Micro Towel.jpg",
        price: 70,
        unit: "per piece",
        hasLtOptions: true,
        qtyOptions: [5, 10, 20],
        qtyLabel: " pcs",
        description: "Ultra soft Micro Towel"
      },
      {
        id: 8,
        name: "Micro Towel",
        image: "Micro Towel 2.jpg",
        price: 110,
        unit: "per piece",
        hasLtOptions: true,
        qtyOptions: [5, 10, 20],
        qtyLabel: " pcs",
        description: "Ultra soft Micro Towel"
      },
      {
        id: 9,
        name: "Micro Towel",
        image: "Micro Towel 3.jpg",
        price: 130,
        unit: "per piece",
        hasLtOptions: true,
        qtyOptions: [5, 10, 20],
        qtyLabel: " pcs",
        description: "Ultra soft Micro Towel"
      }
    ];

    const LT_OPTIONS = [10, 35, 50];
    let cart = {};

    function addToCart(productId) {
      flyToCart(productId);
      const product = products.find(p => p.id === productId);
      if (!product) return;
      const card = document.querySelector(`[data-product-id="${productId}"]`);
      let selectedQty = 1;
      if (card) {
        const activeBtn = card.querySelector('.qty-btn.active');
        if (activeBtn) selectedQty = parseInt(activeBtn.dataset.lt, 10);
      }
      const key = `${productId}_${selectedQty}`;
      if (cart[key]) cart[key].qty += 1;
      else cart[key] = {
        product,
        qty: 1,
        selectedQty
      };
      localStorage.setItem(APP.CART_STORAGE_KEY, JSON.stringify(cart));
      setTimeout(() => {
        updateCartUI();
      }, APP.CART_ANIMATION_MS);
      showAddedFeedback(productId);
    }

    function updateCartUI() {
      const keys = Object.keys(cart);
      const totalItems = keys.reduce((s, k) => s + cart[k].qty, 0);
      const badge = document.getElementById('cartBadge');
      const footer = document.getElementById('cartFooter');
      const list = document.getElementById('cartItemsList');
      if (!badge || !footer || !list) return;

      badge.style.display = totalItems > 0 ? 'flex' : 'none';
      badge.textContent = String(totalItems);

      if (keys.length === 0) {
        list.innerHTML = `<div class="cart-empty-msg"><i class="fas fa-shopping-cart text-3xl mb-3 block opacity-30"></i>Your cart is empty</div>`;
        footer.style.display = 'none';
        return;
      }

      footer.style.display = 'block';
      let grandTotal = 0,
        itemsHTML = '';

      keys.forEach(key => {
        const {
          product,
          qty,
          selectedQty
        } = cart[key];
        const totalQty = selectedQty * qty;
        const lineTotal = product.price * totalQty;
        grandTotal += lineTotal;
        const qLabel = (product.hasLtOptions && !product.qtyOptions) ?
          ' Lt' :
          (product.qtyOptions ?
            (product.qtyLabel || ' pcs') :
            ' pcs');

        itemsHTML += `<div class="cart-item-row"><div style="flex:1"><p style="font-weight:500;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${product.name}</p>
             <p style="font-size:11px;color:#64748b;">${totalQty}${qLabel} × ₹${product.price}/${qLabel.trim()} </p>
              </div><div class="cart-item-qty-ctrl"><button class="cart-qty-btn" onclick="changeCartQty('${key}',-1)">−</button><span style="min-width:40px;text-align:center;font-size:12px;">${totalQty}${qLabel}</span><button class="cart-qty-btn" onclick="changeCartQty('${key}',1)">+</button></div><div style="display:flex;align-items:center;gap:8px;"><span style="font-weight:700;color:#1d4ed8;">₹${lineTotal}</span><button onclick="removeFromCart('${key}')" style="background:#fee2e2;border-radius:50%;width:20px;height:20px;color:#ef4444;">✕</button></div></div>`;
      });

      list.innerHTML = itemsHTML;
      const subtotalEl = document.getElementById('cartSubtotal');
      const totalEl = document.getElementById('cartTotal');
      if (subtotalEl) subtotalEl.innerHTML = `₹${grandTotal}`;
      if (totalEl) totalEl.innerHTML = `₹${grandTotal}`;

      const safeAmount = Math.round(grandTotal);
      const note = Object.values(cart).map(({
        product,
        qty,
        selectedQty
      }) => {
        const totalQty = selectedQty * qty;
        const label = (product.hasLtOptions && !product.qtyOptions) ? 'Lt' : (product.qtyOptions ? product.qtyLabel.trim() : '');
        return `${product.name} ${totalQty}${label}`;
      }).join(', ').replace(/[^a-zA-Z0-9 ]/g, '').substring(0, 50);

      const upiLink = `upi://pay?pa=boism-9352470085@boi&pn=Swapnil%20Chemicals&am=${safeAmount}&cu=${APP.CURRENCY}&tn=${encodeURIComponent(note)}`;
      const gpayBtn = document.getElementById('cartGpayBtn');
      if (gpayBtn) {
        gpayBtn.innerHTML = `
      <i class="fab fa-whatsapp"></i>
      Enquiry ₹${safeAmount}
  `;
      }
      void upiLink;
    }

    function changeCartQty(key, delta) {
      if (!cart[key]) return;
      const newQty = cart[key].qty + delta;
      if (newQty < 1) return;
      cart[key].qty = newQty;
      localStorage.setItem(APP.CART_STORAGE_KEY, JSON.stringify(cart));
      updateCartUI();
    }

    function removeFromCart(key) {
      delete cart[key];
      localStorage.setItem(APP.CART_STORAGE_KEY, JSON.stringify(cart));
      updateCartUI();
    }

    function clearCart() {
      cart = {};
      localStorage.removeItem(APP.CART_STORAGE_KEY);
      updateCartUI();
      const cartPanel = document.getElementById('cartPanel');
      if (cartPanel) cartPanel.classList.add('hidden');
    }

    function toggleCart() {
      const panel = document.getElementById('cartPanel');
      if (panel) panel.classList.toggle('hidden');
    }

    function flyToCart(productId) {
      const card = document.querySelector(`[data-product-id="${productId}"]`);
      const cartBtn = document.querySelector('.cart-icon-btn');
      if (!card || !cartBtn) return;
      const cardRect = card.getBoundingClientRect();
      const cartRect = cartBtn.getBoundingClientRect();
      const flyEl = document.createElement('div');
      flyEl.className = 'fly-item';
      flyEl.innerHTML = '<i class="fas fa-box"></i>';
      flyEl.style.left = (cardRect.left + cardRect.width / 2 - 40) + 'px';
      flyEl.style.top = (cardRect.top + cardRect.height / 2 - 40) + 'px';
      document.body.appendChild(flyEl);
      const targetX = cartRect.left + cartRect.width / 2 - 25;
      const targetY = cartRect.top + cartRect.height / 2 - 25;
      requestAnimationFrame(() => {
        flyEl.style.transition = 'all 2.2s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        flyEl.style.left = targetX + 'px';
        flyEl.style.top = targetY + 'px';
        flyEl.style.transform = 'scale(0.3)';
        flyEl.style.opacity = '0';
      });
      setTimeout(() => {
        flyEl.remove();
        const badge = document.querySelector('.cart-badge');
        if (badge) {
          badge.style.transform = 'scale(1.8)';
          setTimeout(() => badge.style.transform = 'scale(1)', 300);
        }
      }, APP.CART_ANIMATION_MS);
    }

    function openCartEnquiry() {
      let productsHtml = "";
      Object.keys(cart).forEach(key => {
        const item = cart[key];
        const product = item.product;
        const qty = item.selectedQty * item.qty;
        const label = product.hasLtOptions && !product.qtyOptions ?
          "Lt" :
          (product.qtyLabel || "pcs");

        productsHtml += `
          <div class="enquiry-product-preview">
              <img src="${product.image}" alt="${product.name}" loading="lazy" decoding="async">
              <div>
                  <p class="text-xs font-bold text-sky-700">Selected Product</p>
                  <p class="font-bold text-gray-800">${product.name}</p>
                  <p class="text-sm font-semibold text-blue-600 mt-1">${qty} ${label} × ₹${product.price}/${label.trim()}</p>
              </div>
          </div>
          `;
      });

      const body = document.querySelector(".enquiry-body");
      if (!body) return;
      body.innerHTML = `
          ${productsHtml}
          <div class="enquiry-field-wrap">
              <label class="text-xs font-bold text-gray-600 uppercase">Workshop Name & Address</label>
              <textarea id="cart-enquiry-details" class="enquiry-textarea" rows="2" placeholder="Any specific requirements..."></textarea>
          </div>
          <div class="enquiry-field-wrap">
              <label class="text-xs font-bold text-gray-600 uppercase">Your Phone Number *</label>
              <input type="tel" id="cart-enquiry-phone" class="enquiry-input" maxlength="10" placeholder="9876543210">
          </div>
          <button class="enquiry-submit-btn" onclick="submitCartEnquiry()">
              <i class="fab fa-whatsapp"></i>
              Send Enquiry via WhatsApp
          </button>
          <p class="text-center text-xs text-gray-400 mt-3">Your enquiry will be sent directly to <b>Swapnil Chemicals</b> on WhatsApp</p>
      `;
      const modal = document.getElementById('enquiryModal');
      if (modal) modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function submitCartEnquiry() {
      const phoneEl = document.getElementById('cart-enquiry-phone');
      const detailsEl = document.getElementById('cart-enquiry-details');
      const phone = phoneEl ? phoneEl.value.trim() : "";
      if (!isValidIndianMobile(phone)) {
        alert("Enter valid phone number");
        return;
      }
      const details = detailsEl ? detailsEl.value.trim() : "";
      let msg = `🛒 *Cart Enquiry — Swapnil Chemicals*%0A%0A`;
      let grandTotal = 0;
      Object.keys(cart).forEach(key => {
        const item = cart[key];
        const product = item.product;
        const qty = item.selectedQty * item.qty;
        const label = product.hasLtOptions && !product.qtyOptions ?
          "Lt" :
          (product.qtyLabel || "pcs");
        const lineTotal = product.price * qty;
        grandTotal += lineTotal;
        msg += `📦 ${encodeURIComponent(product.name)} - Qty: ${qty} ${encodeURIComponent(label)}, Price: ₹${product.price} = Total: ₹${lineTotal}%0A`;
      });
      msg += `%0A📝 Details: ${encodeURIComponent(details)}`;
      msg += `%0A📱 Phone: ${encodeURIComponent(phone)}`;
      msg += `%0A💰 Grand Total: ₹${grandTotal}`;
      safeOpenNewTab(`https://wa.me/${APP.WA_NUMBER}?text=${msg}`);
      closeEnquiryModal();
    }

    function showAddedFeedback(productId) {
      const btn = document.querySelector(`[data-add-cart="${productId}"]`);
      if (btn) {
        btn.classList.add('added');
        btn.innerHTML = '<i class="fas fa-check"></i> Added!';
        setTimeout(() => {
          btn.classList.remove('added');
          btn.innerHTML = '<i class="fas fa-shopping-cart"></i> Add to Cart';
        }, 1500);
      }
    }

    function createProductCard(product) {
      const hasLt = product.hasLtOptions;
      const qtyOpts = product.qtyOptions || LT_OPTIONS;
      const qtyLabel = product.qtyLabel || 'Lt';
      let qtyBtnsHtml = '';
      if (hasLt) {
        qtyBtnsHtml = `<div class="qty-section mt-3"><p class="text-xs font-semibold text-gray-500 mb-2">Select Quantity</p><div class="flex gap-2 flex-wrap mb-3">` +
          qtyOpts.map((qty, i) => `<button class="qty-btn ${i===0?'active':''}" data-lt="${qty}" data-price="${product.price}" data-product="${encodeURIComponent(product.name)}" data-qty-label="${qtyLabel}" onclick="selectQty(this)">${qty} ${qtyLabel}</button>`).join('') +
          `</div></div>`;
      } else {
        qtyBtnsHtml = '';
      }
      return `<div class="product-card group" data-product-id="${product.id}"><div class="product-image-container"><img src="${product.image}" alt="${product.name}" class="product-image" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.opacity='1';"><div class="product-image-fallback"><i class="fas fa-image text-4xl mb-2"></i><p>Image not available</p></div></div><div class="p-6"><h3 class="text-lg font-bold text-gray-800 mb-2 group-hover:text-blue-600">${product.name}</h3><p class="text-sm text-gray-500 mb-4">${product.description}</p><div class="flex justify-between items-center"><div class="text-xl font-extrabold text-slate-900">₹${product.price}<span class="text-sm font-medium text-gray-500 ml-1">/${product.unit}</span></div><div class="flex space-x-2"><a href="tel:9352470085" class="bg-slate-900 hover:bg-blue-600 text-white px-3 py-2 rounded-lg text-sm transition" aria-label="Call for ${product.name}"><i class="fas fa-phone"></i></a><button class="enquiry-trigger-btn" onclick='openEnquiryModal(${JSON.stringify(product)})'><i class="fas fa-clipboard-list"></i> Enquiry</button></div></div>${qtyBtnsHtml}<button class="add-to-cart-btn" data-add-cart="${product.id}" onclick="addToCart(${product.id})"><i class="fas fa-shopping-cart"></i> Add to Cart</button></div></div>`;
    }

    function selectQty(btn) {
      const card = btn.closest('.product-card');
      if (!card) return;
      card.querySelectorAll('.qty-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    function renderProducts() {
      const container = document.getElementById('productsGrid');
      if (container) container.innerHTML = products.map(p => createProductCard(p)).join('');
    }

    let currentEnquiryProduct = null;

    /*
     * NOTE: the functions below (openEnquiryModal, closeEnquiryModal, submitEnquiry)
     * were cut off by the chat's paste-length limit before I could see your originals.
     * I reconstructed them from the identical pattern already fully visible in
     * openCartEnquiry()/submitCartEnquiry() above (same modal, same fields, same
     * WhatsApp message format) so the site is fully functional to preview.
     * If your original versions differed in wording or fields, replace these three
     * functions with your source of truth.
     */
    function openEnquiryModal(product) {
      currentEnquiryProduct = product;
      const productName = document.getElementById('enquiry-product-name');
      const productImg = document.getElementById('enquiry-product-img');
      const productRate = document.getElementById('enquiry-product-rate');
      const container = document.getElementById('enquiry-qty-buttons');
      const qtyValue = document.getElementById('enquiry-qty-value');
      if (!productName || !productImg || !productRate || !container || !qtyValue) return;

      productName.textContent = product.name;
      productImg.src = product.image;
      productImg.alt = product.name;
      productRate.textContent = `₹${product.price} / ${product.unit}`;

      const hasLt = product.hasLtOptions;
      const qtyOpts = product.qtyOptions || (hasLt ? LT_OPTIONS : [1]);
      const qtyLabel = product.qtyLabel || (hasLt ? ' Lt' : ' pcs');

      container.innerHTML = qtyOpts.map((qty, i) =>
        `<button type="button" class="enquiry-qty-btn ${i === 0 ? 'active' : ''}" data-qty="${qty}" onclick="selectEnquiryQty(this)">${qty}${qtyLabel}</button>`
      ).join('');
      qtyValue.value = qtyOpts[0];

      const detailsEl = document.getElementById('enquiry-details');
      const phoneEl = document.getElementById('enquiry-phone');
      const phoneErrorEl = document.getElementById('phone-error');
      if (detailsEl) detailsEl.value = '';
      if (phoneEl) phoneEl.value = '';
      if (phoneErrorEl) phoneErrorEl.classList.add('hidden');

      const modal = document.getElementById('enquiryModal');
      if (modal) modal.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function selectEnquiryQty(btn) {
      const container = btn.closest('.enquiry-qty-buttons');
      if (!container) return;
      container.querySelectorAll('.enquiry-qty-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const qtyValue = document.getElementById('enquiry-qty-value');
      if (qtyValue) qtyValue.value = btn.dataset.qty;
    }

    function closeEnquiryModal() {
      const modal = document.getElementById('enquiryModal');
      if (modal) modal.classList.remove('show');
      document.body.style.overflow = '';
      currentEnquiryProduct = null;
    }

    function submitEnquiry() {
      if (!currentEnquiryProduct) return;
      const phoneEl = document.getElementById('enquiry-phone');
      const detailsEl = document.getElementById('enquiry-details');
      const qtyValueEl = document.getElementById('enquiry-qty-value');
      const phoneErrorEl = document.getElementById('phone-error');
      const phone = phoneEl ? phoneEl.value.trim() : '';

      if (!isValidIndianMobile(phone)) {
        if (phoneErrorEl) phoneErrorEl.classList.remove('hidden');
        return;
      }
      if (phoneErrorEl) phoneErrorEl.classList.add('hidden');

      const details = detailsEl ? detailsEl.value.trim() : '';
      const qty = qtyValueEl ? qtyValueEl.value : '1';
      const product = currentEnquiryProduct;
      const label = product.hasLtOptions && !product.qtyOptions ? 'Lt' : (product.qtyLabel || 'pcs').trim();
      const lineTotal = product.price * Number(qty);

      let msg = `📋 *Product Enquiry — Swapnil Chemicals*%0A%0A`;
      msg += `📦 ${encodeURIComponent(product.name)} - Qty: ${qty} ${encodeURIComponent(label)}, Price: ₹${product.price} = Total: ₹${lineTotal}%0A`;
      msg += `%0A📝 Details: ${encodeURIComponent(details)}`;
      msg += `%0A📱 Phone: ${encodeURIComponent(phone)}`;

      safeOpenNewTab(`https://wa.me/${APP.WA_NUMBER}?text=${msg}`);
      closeEnquiryModal();
    }

    function initScrollToTop() {
      const btn = document.getElementById('scrollToTop');
      if (!btn) return;
      window.addEventListener('scroll', () => {
        btn.classList.toggle('hidden', window.scrollY < 400);
      });
      btn.addEventListener('click', () => window.scrollTo({
        top: 0,
        behavior: 'smooth'
      }));
    }

    document.addEventListener('DOMContentLoaded', () => {
      cart = safeParseJSON(localStorage.getItem(APP.CART_STORAGE_KEY), {});
      renderProducts();
      updateCartUI();
      initScrollToTop();
    });
  </script>

</body>

</html>
